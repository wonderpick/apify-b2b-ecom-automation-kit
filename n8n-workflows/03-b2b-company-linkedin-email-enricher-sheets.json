      "id": "b1a2c3d4-0003-4000-8000-000000000003",
      "name": "Read Raw Companies from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        420,
        610
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json || {});\nconst unique = new Set();\n\nfor (const row of rows) {\n  const val = row.company || row.domain || row.email || row.name || '';\n  if (typeof val === 'string' && val.trim().length > 0) {\n    unique.add(val.trim());\n  }\n}\n\nconst inputs = unique.size > 0 ? Array.from(unique) : ['Stripe', 'Linear', 'canva.com'];\n\nreturn [\n  {\n    json: {\n      inputs,\n      enrichContactPages: true,\n      includeUnresolved: true,\n      minConfidence: 'medium',\n      concurrency: 6\n    }\n  }\n];"
      },
      "id": "b1a2c3d4-0003-4000-8000-000000000004",
      "name": "Deduplicate & Batch Company Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        610
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/maitreya_buddha~b2b-company-domain-linkedin-enricher/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "memory",
              "value": "256"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: $json.inputs, enrichContactPages: $json.enrichContactPages, includeUnresolved: $json.includeUnresolved, minConfidence: $json.minConfidence, concurrency: $json.concurrency }) }}",
        "options": {
          "timeout": 180000
        }
      },

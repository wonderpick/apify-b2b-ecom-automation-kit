      "id": "b1a2c3d4-0003-4000-8000-000000000007",
      "name": "Log Unresolved Leads ($0)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1500,
        790
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json || {};\n  const emails = Array.isArray(d.emails) ? d.emails : [];\n  const whatsappLinks = Array.isArray(d.whatsappLinks) ? d.whatsappLinks : [];\n  const phones = Array.isArray(d.phones) ? d.phones : [];\n  const socials = d.socials && typeof d.socials === 'object' ? d.socials : {};\n\n  const primaryEmail = d.emailMxValid === false ? '' : (d.primaryEmail || emails[0] || '');\n  const primaryWhatsapp = whatsappLinks[0] || '';\n  const primaryPhone = phones[0] || '';\n  const hasValidEmail = Boolean(primaryEmail && d.emailMxValid !== false);\n  const hasDirectContact = Boolean(hasValidEmail || primaryWhatsapp);\n  const isHighConf = String(d.confidence || '').toLowerCase() === 'high';\n\n  let leadTier = 'RESEARCH';\n  if (isHighConf && hasDirectContact && d.linkedinUrl) {\n    leadTier = 'HOT';\n  } else if (hasDirectContact || primaryPhone) {\n    leadTier = 'WARM';\n  }\n\n  const emoji = leadTier === 'HOT' ? ':fire:' : leadTier === 'WARM' ? ':white_check_mark:' : ':mag:';\n\n  const slackSummary = [\n    `${emoji} *[${leadTier}] Enriched B2B Lead:* ${d.pageTitle || d.input}`,\n    `*Domain:* ${d.domain || 'N/A'} (${d.websiteUrl || 'N/A'})`,\n    `*LinkedIn:* ${d.linkedinUrl || 'Not found'}`,\n    `*Email:* ${primaryEmail || 'None'} | *WhatsApp:* ${primaryWhatsapp || 'None'} | *Phone:* ${primaryPhone || 'None'}`,\n    `*Confidence:* ${d.confidence || 'N/A'} (matched by: ${d.matchedBy || 'N/A'})`\n  ].join('\\n');\n\n  const emailSubject = `[HOT B2B Lead] ${d.pageTitle || d.input} (${d.domain || 'N/A'})`;\n  const emailBody = [\n    `Lead Tier: ${leadTier}`,\n    `Input: ${d.input}`,\n    `Company / Title: ${d.pageTitle || 'N/A'}`,\n    `Official Domain: ${d.domain || 'N/A'}`,\n    `Website: ${d.websiteUrl || 'N/A'}`,\n    `LinkedIn: ${d.linkedinUrl || 'N/A'}`,\n    `Primary Email: ${primaryEmail || 'N/A'}`,\n    `WhatsApp: ${primaryWhatsapp || 'N/A'}`,\n    `Phone: ${primaryPhone || 'N/A'}`,\n    `Confidence: ${d.confidence || 'N/A'} (${d.matchedBy || 'N/A'})`,\n    `Enriched At: ${d.enrichedAt || 'N/A'}`\n  ].join('\\n');\n\n  results.push({\n    json: {\n      ...d,\n      leadTier,\n      primaryEmail,\n      primaryWhatsapp,\n      primaryPhone,\n      xUrl: socials.x || '',\n      githubUrl: socials.github || '',\n      slackSummary,\n      emailSubject,\n      emailBody\n    }\n  });\n}\n\nreturn results;"
      },

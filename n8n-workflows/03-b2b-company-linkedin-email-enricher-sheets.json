      "id": "b1a2c3d4-0003-4000-8000-000000000003",
      "name": "Read Companies from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all()\n  .map((item) => item.json.company || item.json.domain || item.json.email || item.json.name)\n  .filter((v) => typeof v === 'string' && v.trim().length > 0);\n\nreturn [{ json: { inputs } }];"
      },
      "id": "b1a2c3d4-0003-4000-8000-000000000004",
      "name": "Batch Inputs Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/maitreya_buddha~b2b-company-domain-linkedin-enricher/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,

      "parameters": {},
      "id": "b1a2c3d4-0005-4000-8000-000000000002",
      "name": "Manual Stockist Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        180,
        700
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "",

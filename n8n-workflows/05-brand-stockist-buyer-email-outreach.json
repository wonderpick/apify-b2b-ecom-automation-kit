      "id": "b1a2c3d4-0005-4000-8000-000000000003",
      "name": "Read Competitor Brands from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        420,
        610
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json || {});\nconst urlSet = new Set();\nlet countryFilter = '';\nlet maxStoresPerBrand = 100;\n\nfor (const row of rows) {\n  const raw = row.brandUrl || row.brand_url || row.url || '';\n  if (typeof raw === 'string' && raw.trim().length > 0) {\n    urlSet.add(raw.trim());\n  }\n  if (!countryFilter && typeof row.countryFilter === 'string' && row.countryFilter.trim()) {\n    countryFilter = row.countryFilter.trim();\n  }\n  const maxS = Number(row.maxStoresPerBrand ?? row.max_stores_per_brand);\n  if (Number.isFinite(maxS) && maxS >= 1 && maxS <= 5000) {\n    maxStoresPerBrand = Math.round(maxS);\n  }\n}\n\nconst urls = urlSet.size > 0\n  ? Array.from(urlSet)\n  : ['https://fellowproducts.com', 'https://brooklynhotdogcompany.com'];\n\nreturn [\n  {\n    json: {\n      urls,\n      enrichEmails: true,\n      onlyIndependentStores: true,\n      onlyWithEmail: false,\n      maxStoresPerBrand,\n      countryFilter,\n      maxConcurrency: 3\n    }\n  }\n];"
      },
      "id": "b1a2c3d4-0005-4000-8000-000000000004",
      "name": "Build Stockist Batch Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        610
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/maitreya_buddha~brand-store-locator-stockist-email-enricher/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "memory",
              "value": "256"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: $json.urls, enrichEmails: $json.enrichEmails, onlyIndependentStores: $json.onlyIndependentStores, onlyWithEmail: $json.onlyWithEmail, maxStoresPerBrand: $json.maxStoresPerBrand, countryFilter: $json.countryFilter, maxConcurrency: $json.maxConcurrency }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "id": "b1a2c3d4-0005-4000-8000-000000000005",
      "name": "Extract Stockists & Buyer Emails via Apify",
      "type": "n8n-nodes-base.httpRequest",

      "id": "b1a2c3d4-0005-4000-8000-000000000007",
      "name": "Log Social & Form Boutiques",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1500,
        790
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json || {};\n  const score = Number(d.outreachReadinessScore || 0);\n  const emailType = String(d.emailType || '');\n\n  let outreachTier = 'NURTURE';\n  if (score >= 85 || emailType === 'wholesale_buyer') {\n    outreachTier = 'VIP_BUYER';\n  } else if (score >= 60 || d.retailerType === 'independent_boutique') {\n    outreachTier = 'DIRECT_BOUTIQUE';\n  }\n\n  const locLabel = [d.city, d.state, d.country].filter(Boolean).join(', ') || d.address || 'Location N/A';\n  const emoji = outreachTier === 'VIP_BUYER' ? ':dart:' : outreachTier === 'DIRECT_BOUTIQUE' ? ':convenience_store:' : ':bookmark:';\n\n  const slackSummary = [\n    `${emoji} *[${outreachTier}] Retail Stockist Lead:* ${d.storeName} (Score: *${score}/100*)`,\n    `*Carries Competitor:* ${d.brandUrl}`,\n    `*Retailer Type:* ${d.retailerType} | *Location:* ${locLabel}`,\n    `*Buyer Email:* ${d.primaryEmail} (\\`${emailType || 'general'}\\`)`,\n    `*Website:* ${d.website || 'N/A'} | *Instagram:* ${d.instagram || 'N/A'}`,\n    `*Contact Page:* ${d.contactPageUrl || 'N/A'} | *Phone:* ${d.phone || 'N/A'}`\n  ].join('\\n');\n\n  const pitchSubject = `[VIP Retail Buyer] ${d.storeName} (${locLabel}) — Score ${score}/100`;\n  const pitchBody = [\n    `Outreach Tier: ${outreachTier}`,\n    `Store Name: ${d.storeName}`,\n    `Retailer Type: ${d.retailerType}`,\n    `Location: ${locLabel}`,\n    `Competitor Brand Carried: ${d.brandUrl}`,\n    `Buyer Email: ${d.primaryEmail} (${emailType || 'general'}, confidence: ${d.emailConfidence})`,\n    `Phone: ${d.phone || 'N/A'}`,\n    `Website: ${d.website || 'N/A'}`,\n    `Instagram: ${d.instagram || 'N/A'}`,\n    `Contact / Wholesale Page: ${d.contactPageUrl || 'N/A'}`,\n    `Outreach Readiness Score: ${score}/100`\n  ].join('\\n');\n\n  results.push({\n    json: {\n      ...d,\n      outreachTier,\n      slackSummary,\n      pitchSubject,\n      pitchBody\n    }\n  });\n}\n\nreturn results;"
      },

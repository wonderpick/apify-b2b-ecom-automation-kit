      "typeVersion": 4.5,
      "position": [
        400,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const urls = $input.all()\n  .map((item) => item.json.bioUrl || item.json.url || item.json.externalUrl)\n  .filter((v) => typeof v === 'string' && v.trim().length > 0);\n\nreturn [{ json: { urls } }];"
      },
      "id": "b1a2c3d4-0004-4000-8000-000000000004",
      "name": "Batch Bio URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

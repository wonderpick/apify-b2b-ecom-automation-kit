{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wonderpick/apify-b2b-ecom-automation-kit",
  "title": "Apify External Business Intelligence MCP Server",
  "description": "8 external-intel tools & 6 prompts: B2B site audits, stockists, Shopify, SOC 2 & K-Beauty.",
  "version": "2.1.1",
  "icons": [
    {
      "src": "https://apify-factory-rapidapi-gateway.apify-factory-rapidapi-gateway.workers.dev/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    },
    {
      "src": "https://apify-factory-rapidapi-gateway.apify-factory-rapidapi-gateway.workers.dev/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/wonderpick/apify-b2b-ecom-automation-kit",
    "source": "github"
  },
  "websiteUrl": "https://glama.ai/mcp/servers/wonderpick/apify-b2b-ecom-automation-kit",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://apify-factory-rapidapi-gateway.apify-factory-rapidapi-gateway.workers.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <APIFY_TOKEN> (required only for tools/call; discovery works without a token).",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
